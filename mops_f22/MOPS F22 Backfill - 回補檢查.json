    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.stdout || '').trim();\nfunction escapeHtml(text) {\n  return (text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\nlet messages;\ntry {\n  messages = JSON.parse(raw);\n  if (!Array.isArray(messages)) messages = [{ message: raw, group: 'f22_backfill' }];\n} catch (e) {\n  // stdout 不是 JSON（例如沒帶 --emit）→ 整段純文字當一則訊息送出\n  messages = raw ? [{ message: raw, group: 'f22_backfill' }] : [];\n}\nreturn messages.map(m => ({ json: { group: m.group || m.sheet || 'f22_backfill', message: escapeHtml(m.message) } }));"
      },
      "id": "a1b2c3d4-3333-4a03-9003-aa0000000003",
