              "field": "cronExpression",
              "expression": "0,30 8-13 * * 1-5"
            },
            {
              "field": "cronExpression",
              "expression": "0 14 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "python3 /Users/starmark/Downloads/scripts/market_check.py"
      },
      "id": "execute-command",
      "name": "執行 market_check.py",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "1085373824",
